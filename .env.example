# ── LLM provider ──
# Which LLM backend the agents use. Default: groq.
# LLM_PROVIDER=groq

# Groq API key — used when LLM_PROVIDER=groq (the default)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the default Groq model. Groq's model catalog changes over time —
# if you see a "model_not_found" error, list current models with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=openai/gpt-oss-120b

# OpenAI — used when LLM_PROVIDER=openai instead
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Search provider ──
# Tavily API key — used for web search. Get one at https://app.tavily.com
# If omitted, the app falls back to mock search results instead of failing.
TAVILY_API_KEY=
# SEARCH_PROVIDER=tavily

# ── Server ──
# Comma-separated list of allowed CORS origins for the FastAPI server (defaults to "*")
# CORS_ORIGINS=http://localhost:5500,https://your-frontend.example.com

# If set, all POST endpoints require this value in the X-API-Key header.
# Leave unset for local dev. Set this before deploying the API anywhere public.
# API_KEY=

# Requests per minute allowed per API key (or per client IP if no API_KEY is set) on the
# run/search/browse endpoints. In-memory, single-process only. 0 disables the limit.
# RATE_LIMIT_PER_MINUTE=30

# Where run history (SQLite) is written. Defaults to ./agent_history.db
# AGENT_DB_PATH=agent_history.db

# Log verbosity: DEBUG, INFO (default), WARNING, ERROR
# LOG_LEVEL=INFO
